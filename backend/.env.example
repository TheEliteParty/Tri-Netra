APP_ENV=development
DATABASE_URL=sqlite:///./trinetra.db
JWT_SECRET=replace-with-a-long-random-value-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_SEED_DATABASE=true

# Production uses environment-provided passwords. Admin is required; the
# remaining roles are optional.
TRINETRA_ADMIN_PASSWORD=replace-with-a-strong-production-password
TRINETRA_FIELD_PASSWORD=
TRINETRA_DISTRICT_PASSWORD=
TRINETRA_CITIZEN_PASSWORD=

# Optional absolute GIS directory override. The default is frontend/public/gis.
GIS_ASSET_DIR=
